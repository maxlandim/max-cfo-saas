# Copie para .env.local (no computador) e cadastre as mesmas variáveis na Vercel:
# Project → Settings → Environment Variables.

# Endereço público do site (usado nos links de retorno do pagamento)
NEXT_PUBLIC_SITE_URL=https://max-cfo-saas.vercel.app

# Conta de serviço do Firebase (Console do Firebase → Configurações do projeto → Contas de serviço →
# Gerar nova chave privada). Cole o JSON inteiro numa linha ou em base64.
FIREBASE_SERVICE_ACCOUNT=

# E-mails com acesso total sem assinatura (separados por vírgula)
ADMIN_EMAILS=maxpaeslandim@gmail.com

# Stripe (Dashboard → Desenvolvedores → Chaves de API e Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Gemini (aistudio.google.com → Get API key) para o CFO IA e a leitura de boletos e notas
GEMINI_API_KEY=

# Opcionais
TRIAL_DAYS=7
CHAT_LIMIT_PER_HOUR=40
DOC_LIMIT_PER_HOUR=30
# Modelo da IA (padrão gemini-2.5-flash)
GEMINI_MODEL=

# Variáveis do servidor (copie para .env no servidor ou cadastre no Coolify). NUNCA coloque valores reais no GitHub.

# Firebase Admin: JSON da conta de serviço (Firebase › Configurações do projeto › Contas de serviço › Gerar nova chave privada).
# Pode colar o JSON inteiro ou em base64. Libera a verificação de assinatura e o bloqueio por plano.
FIREBASE_SERVICE_ACCOUNT=

# IA do Google (aistudio.google.com/apikey)
# GEMINI_API_KEY não é mais usada: leitura de documentos e CFO funcionam sem IA externa
# Opcional: lista de modelos em ordem de preferência

# Asaas (pagamentos: cartão, Pix e boleto)
# Chave da API: produção começa com $aact_prod_, sandbox com $aact_hmlg_ (o sistema escolhe o ambiente pelo prefixo)
ASAAS_API_KEY=
# Token do webhook (32 a 255 caracteres, sem espaços), igual ao cadastrado no Asaas
ASAAS_WEBHOOK_TOKEN=

# E-mails com acesso de administrador (separados por vírgula)
ADMIN_EMAILS=
# Contas de cortesia (plano Escritório sem pagar, sem acesso ao painel do administrador), separadas por vírgula
CORTESIA_EMAILS=

# Endereço público do site (para os links de volta do Stripe), ex.: https://landimadvisory.com.br
# NEXT_PUBLIC_SITE_URL=

# Lembretes de vencimento por e-mail (resend.com: crie a conta, verifique o domínio e gere a chave)
RESEND_API_KEY=
# Remetente com o domínio verificado no Resend
# LEMBRETES_REMETENTE=Landim Advisory <avisos@landimadvisory.com.br>
# Senha da tarefa diária que chama /api/lembretes (invente uma longa, ex.: 40 letras e números)
CRON_SECRET=
# Tarefas agendadas no Coolify (Scheduled Tasks), uma vez por dia:
#   backup:     wget -qO- --header "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/backup
#   lembretes:  wget -qO- --header "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/lembretes

# E-mails do teste grátis: endereço que recebe as respostas dos clientes (padrão: o primeiro de ADMIN_EMAILS)
# EMAIL_RESPOSTA=contato@landimadvisory.com.br

# Nota fiscal de serviço automática nas mensalidades (configure antes as informações fiscais no Asaas)
# NFSE_ATIVA=1
# NFSE_SERVICO_ID=        (id do serviço em GET /v3/fiscalInfo/services) ou
# NFSE_SERVICO_CODIGO=    (código do serviço na prefeitura)
# NFSE_SERVICO_NOME=Licenciamento de uso de software (sistema de gestão financeira)
# NFSE_ISS=2              (alíquota do ISS em %)

# Opcional: segredo próprio para criptografar as chaves do Asaas dos clientes (padrão: derivado da conta de serviço do Firebase)
# CHAVE_CRIPTO=

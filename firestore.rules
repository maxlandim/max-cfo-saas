rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Espaço de dados de uma empresa. O dono é o usuário cujo uid é o id do espaço (empresa principal)
    // ou o prefixo do id, no formato "<uid>__<empresa>" (demais empresas do mesmo login, para BPOs e grupos).
    function donoDoEspaco(wsId) {
      return request.auth != null
        && (wsId == request.auth.uid || wsId.matches(request.auth.uid + '__[a-z0-9]{4,24}'));
    }

    function emailConfirmado() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    // Analista ou gestor convidado pelo dono (convites/<e-mail>/espacos/<empresa> com papel de edição)
    function editor(wsId) {
      return emailConfirmado()
        && exists(/databases/$(database)/documents/convites/$(request.auth.token.email.lower())/espacos/$(wsId))
        && get(/databases/$(database)/documents/convites/$(request.auth.token.email.lower())/espacos/$(wsId)).data.papel in ['analista', 'gestor'];
    }
    function meuEmail(email) {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == email;
    }

    match /workspaces/{wsId} {
      // A segunda condição permite ler o espaço antigo, que usava o e-mail como id, para a migração automática.
      // A terceira libera a consulta (somente leitura) para o cliente ou contador convidado pelo dono, com e-mail confirmado.
      allow read: if donoDoEspaco(wsId)
        || (request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == wsId)
        || (emailConfirmado() && exists(/databases/$(database)/documents/convites/$(request.auth.token.email.lower())/espacos/$(wsId)));
      allow create, update: if donoDoEspaco(wsId) && request.resource.data.owner == request.auth.uid;
      // Equipe (analista ou gestor) grava os dados, mas não troca o dono
      allow update: if editor(wsId) && request.resource.data.owner == resource.data.owner;
      // A empresa principal não pode ser apagada pelo painel
      allow delete: if donoDoEspaco(wsId) && wsId != request.auth.uid;

      // Empresas com muitos dados: o conteúdo comprimido é dividido em partes (src/lib/espaco.js).
      // Quem pode ler a empresa lê as partes; só o dono grava ou apaga.
      match /partes/{parte} {
        allow read: if donoDoEspaco(wsId)
          || (emailConfirmado() && exists(/databases/$(database)/documents/convites/$(request.auth.token.email.lower())/espacos/$(wsId)));
        allow create, update: if (donoDoEspaco(wsId) && request.resource.data.owner == request.auth.uid)
          || (editor(wsId) && request.resource.data.owner == get(/databases/$(database)/documents/workspaces/$(wsId)).data.owner);
        allow delete: if donoDoEspaco(wsId) || editor(wsId);
      }
    }

    // Lista de empresas do usuário (nomes e CNPJs), lida e gravada só por ele.
    match /perfis/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Convites de acesso somente leitura: convites/<e-mail convidado>/espacos/<id da empresa>.
    // Só o dono da empresa cria ou altera; o convidado lê a própria lista e pode recusar (apagar).
    match /convites/{email}/espacos/{wsId} {
      allow read: if meuEmail(email) || donoDoEspaco(wsId);
      allow create, update: if donoDoEspaco(wsId) && request.resource.data.dono == request.auth.uid && request.resource.data.papel in ['leitura', 'analista', 'gestor'];
      allow delete: if donoDoEspaco(wsId) || meuEmail(email);
    }

    // Assinaturas: o usuário pode ler a própria, mas só o servidor (Firebase Admin) escreve.
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Todo o resto fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
